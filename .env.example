DATABASE_URL=postgres://mgst:mgst@localhost:5433/mgst
SESSION_SECRET=doi-chuoi-nay-khi-chay-that

# ── Kho ảnh chứng minh (AWS S3) ────────────────────────────────────────
# Thiếu bốn biến này thì ảnh ghi vào `public/uploads/` trên đĩa máy chủ và app
# vẫn chạy đầy đủ — bản tạm để làm việc khi chưa có tài khoản AWS. Điền đủ là
# tự động chuyển sang S3, không phải sửa dòng code nào.
# Giới hạn của bản tạm: ảnh nằm trên đĩa máy chủ ứng dụng, deploy dạng
# container hay nhiều máy song song là mất. Xem đầu file src/server/storage.ts.
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tên miền đọc ảnh, nếu đặt CloudFront trước bucket. Bỏ trống thì dùng URL S3
# mặc định (https://<bucket>.s3.<region>.amazonaws.com).
AWS_S3_PUBLIC_URL=
