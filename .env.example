DATABASE_URL=postgres://mgst:mgst@localhost:5433/mgst

# ── Kho ảnh chứng minh (FPT Object Storage, giao thức S3) ──────────────
# Thiếu năm biến này thì ảnh ghi vào `.uploads/` trên đĩa máy chủ và app
# vẫn chạy đầy đủ — bản tạm để làm việc khi chưa có kho lưu trữ. Điền đủ là
# tự động chuyển sang S3, không phải sửa dòng code nào.
# Giới hạn của bản tạm: ảnh nằm trên đĩa máy chủ ứng dụng, deploy dạng
# container hay nhiều máy song song là mất. Xem đầu file src/server/storage.ts.
# ⚠️ Bucket PHẢI để private. Mọi lượt xem ảnh đi qua GET /api/images/<key> và
# route đó đòi phiên đăng nhập; mở bucket ra public là bỏ luôn chốt đó.
S3_ENDPOINT=https://s3-han02.fptcloud.com
S3_REGION=han02
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Thông báo đẩy (Web Push) ──────────────────────────────────────────
# Sinh một lần bằng `npx web-push generate-vapid-keys --json`, dùng chung cho
# iPhone, Android và máy tính. Không cần tài khoản nhà phát triển của Apple.
#
# Khoá công khai đi ra trình duyệt nên mang tiền tố NEXT_PUBLIC. Khoá riêng chỉ
# nằm ở máy chủ. Thiếu một trong hai thì khối bật thông báo tự ẩn.
#
# ⚠️ Trên iPhone chỉ chạy khi người dùng đã thêm trang vào Màn hình chính. Mở
# trong tab Safari thì không nhận được gói tin nào.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mgst.com.vn

# Tài khoản PVI cho bot tạo đơn (pvi-qlcd-playwright).
# `bun run pvi:chay` đọc hai biến này để đăng nhập lại khi phiên hết hạn.
# Thiếu chúng thì bot chỉ chạy được khi `storageState.json` còn phiên.
PVI_USER=
PVI_PASS=

# ── API đối tác PVI (src/server/pvi-api) ──────────────────────────────
# Đường gọi API CHÍNH THỨC, khác hẳn bot Playwright ở PVI_USER/PVI_PASS trên.
# Thiếu CPID hoặc KEY thì mọi lệnh gọi ném PviApiError kind "config"; phần còn
# lại của app vẫn chạy.
#
# PVI_API_ENV chọn máy chủ PVI, hai bản khác cả tên miền lẫn đường dẫn
# (src/server/pvi-api/config.ts, PVI_ENDPOINT_PREFIX):
#   test  http://piastest.pvi.com.vn/API_CP/ManagerApplication   đơn thử
#   prod  https://apiwebview.pvi.com.vn/ManagerApplication        HỢP ĐỒNG THẬT
# Thiếu biến thì là test.
PVI_API_ENV=test
PVI_API_CPID=
PVI_API_KEY=
# Đặt 1 nếu PVI so chữ ký viết HOA. Tài liệu không nói; mọi lệnh gọi trả -105
# thì thử đổi giá trị này trước.
PVI_API_SIGN_UPPERCASE=
PVI_API_TIMEOUT_MS=30000

# ── Đường máy nào xử lý đơn bảo hiểm ───────────────────────────────────────
# MỘT đường mỗi lúc, không chạy song song.
#   api  đơn mới vào hàng chờ của `bun run pvi:api-worker`, TOÀN BỘ
#   bot  đơn mới vào hàng chờ của `bun run pvi:worker`, chia theo PVI_TY_LE_BOT
#   tay  hoặc để rỗng: mọi đơn vào hàng chờ làm tay
#
# ⚠️ Đổi biến này phải làm HAI việc: dựng lại container app, và bật hoặc dừng
# đúng container worker. Bỏ việc thứ hai thì đơn mới nằm chờ một worker không
# chạy.
PVI_ROUTE=tay
# Phần trăm đơn giao cho MÁY khi PVI_ROUTE=bot. Đường api luôn nhận 100%.
PVI_TY_LE_BOT=50

# ── Proxy chạy thử ─────────────────────────────────────────────────────────
# PVI chặn theo IP, chỉ máy chủ chạy thật gọi được. Proxy ở
# src/app/API_CP/ManagerApplication/[endpoint] cho máy cá nhân gọi nhờ.
#
# TRÊN MÁY CHỦ: đặt PVI_PROXY_TOKEN một chuỗi ngẫu nhiên dài. Rỗng thì route
# trả 404. Xoá đi sau khi chạy thử xong — route này tạo đơn THẬT trên PVI.
PVI_PROXY_TOKEN=
#
# TRÊN MÁY CÁ NHÂN: đặt PVI_API_PROXY_TOKEN bằng đúng chuỗi trên, và
# PVI_API_PROXY_ORIGIN là tên miền mgst-app. Máy chủ chọn bản test hay thật theo
# PVI_API_ENV của máy chủ, không theo máy cá nhân.
#   PVI_API_PROXY_ORIGIN=https://app.mgst.com.vn
# Không đặt hai biến này trên máy chủ.
PVI_API_PROXY_TOKEN=
PVI_API_PROXY_ORIGIN=
