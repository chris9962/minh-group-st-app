DATABASE_URL=postgres://mgst:mgst@localhost:5433/mgst

# ── Kho ảnh chứng minh (FPT Object Storage, giao thức S3) ──────────────
# Thiếu năm biến này thì ảnh ghi vào `.uploads/` trên đĩa máy chủ và app
# vẫn chạy đầy đủ — bản tạm để làm việc khi chưa có kho lưu trữ. Điền đủ là
# tự động chuyển sang S3, không phải sửa dòng code nào.
# Giới hạn của bản tạm: ảnh nằm trên đĩa máy chủ ứng dụng, deploy dạng
# container hay nhiều máy song song là mất. Xem đầu file src/server/storage.ts.
# ⚠️ Bucket PHẢI để private. Mọi lượt xem ảnh đi qua GET /api/images/<key> và
# route đó đòi phiên đăng nhập; mở bucket ra public là bỏ luôn chốt đó.
S3_ENDPOINT=https://s3-han02.fptcloud.com
S3_REGION=han02
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tài khoản PVI cho bot tạo đơn (pvi-qlcd-playwright).
# `bun run pvi:chay` đọc hai biến này để đăng nhập lại khi phiên hết hạn.
# Thiếu chúng thì bot chỉ chạy được khi `storageState.json` còn phiên.
PVI_USER=
PVI_PASS=

# ── API đối tác PVI (src/server/pvi-api) ──────────────────────────────
# Đường gọi API CHÍNH THỨC, khác hẳn bot Playwright ở PVI_USER/PVI_PASS trên.
# Thiếu ba biến đầu thì mọi lệnh gọi ném PviApiError kind "config"; phần còn
# lại của app vẫn chạy.
# Bản test của PVI: http://piastest.pvi.com.vn (http, không phải https).
# Chưa có URL chạy thật — hỏi PVI trước khi đẩy đơn của khách.
PVI_API_BASE_URL=http://piastest.pvi.com.vn
PVI_API_CPID=
PVI_API_KEY=
# Đặt 1 nếu PVI so chữ ký viết HOA. Tài liệu không nói; mọi lệnh gọi trả -105
# thì thử đổi giá trị này trước.
PVI_API_SIGN_UPPERCASE=
PVI_API_TIMEOUT_MS=30000
