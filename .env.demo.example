# Env của máy demo. Chép thành `.env.local` trên máy demo rồi điền giá trị.
# Máy demo chạy database riêng, bucket riêng, KHÔNG chạy worker nào (PVI, kiểm
# ảnh, Zalo). Xem ghi chú đầy đủ của từng biến ở `.env.example`.

# Database RIÊNG của demo, container `mgst-demo-db` ở cổng 5434. Cổng 5433 là
# Postgres của production, không được trỏ vào đó.
DATABASE_URL=postgres://mgst_demo:<mật khẩu>@localhost:5434/mgst_demo

# Bật chế độ demo: ảnh tải lên nằm dưới `demo/`, đơn bảo hiểm tạo xong là
# Hoàn thành và trỏ vào 2 ảnh GCN mẫu dưới đây.
DEMO_MODE=1

# Khoá của 2 ảnh GCN mẫu trong bucket `mgst-demo`, tải lên 2026-09-29 từ
# `deploy/demo/`. Đổi ảnh thì tải ảnh mới lên rồi sửa khoá ở đây. Khoá phải có
# dạng `demo/<nhóm>/<YYYY-MM-DD>/<uuid>.webp`, sai dạng thì đơn không có ảnh.
DEMO_GCN_ELECTRIC_KEY=demo/insurance-certificates/2026-09-29/b6c44a59-33b7-4ada-98b6-cef88ff1c844.webp
DEMO_GCN_MOTORBIKE_KEY=demo/insurance-certificates/2026-09-29/53121ce5-a16d-4988-895d-c8e8c5ed92be.webp

# Bucket `mgst-demo` tạo 2026-09-29, private, đã có sẵn 2 ảnh GCN mẫu ở đúng
# 2 khoá cố định. Khoá truy cập dùng chung tài khoản FPT với production.
S3_ENDPOINT=https://s3-han02.fptcloud.com
S3_REGION=han02
S3_BUCKET=mgst-demo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Không có worker nên mọi đơn không đi qua PVI.
PVI_ROUTE=tay

# Máy demo không gọi PVI. Để trống khoá PVI, không đặt PVI_PROXY_TOKEN.
PVI_API_ENV=test
PVI_API_CPID=
PVI_API_KEY=
PVI_PROXY_TOKEN=

# Thông báo đẩy: tuỳ chọn. Để trống thì khối bật thông báo tự ẩn.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mgst.com.vn
