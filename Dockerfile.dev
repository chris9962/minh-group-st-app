# Image DEV — chạy `next dev` với hot reload, KHÔNG phải bản deploy.
#
# Khác Dockerfile prod ở chỗ image này không chứa mã nguồn: mã mount từ máy
# ngoài vào lúc chạy (xem service `app-dev` trong docker-compose.yml), nên sửa
# file là trình duyệt tự nạp lại, không dựng lại image.
#
# Image chỉ mang node_modules cài sẵn để lần chạy đầu không phải đợi
# `bun install` từ con số không. Lockfile đổi thì lệnh install trong CMD cài
# bù phần chênh — thường xong trong vài giây.

# Node là RUNTIME, Bun chỉ CÀI GÓI. `next dev` (Turbopack) chạy bằng Bun không
# nạp được gói external — mọi API route đụng `pg` trả 500 với
# "Failed to load external module pg-<hash>". Bản prod không dính vì
# `server.js` build sẵn, không đi qua Turbopack. Trên máy ngoài, `next` cũng
# chạy bằng Node qua shebang — image này chỉ lặp lại đúng cách đó.
FROM node:22-alpine
COPY --from=oven/bun:1-alpine /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

# Cùng lý do với Dockerfile prod: không chặn thì Chromium của playwright về
# theo, thêm hơn 150MB cho một image không bao giờ chạy e2e.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 3000

# `bun install` chạy MỖI lần khởi động: volume node_modules sống lâu hơn image,
# nên sau khi đổi lockfile và dựng lại image, volume vẫn giữ bản cũ — install
# lúc chạy mới là chỗ đồng bộ thật. Đã đúng lockfile thì lệnh thoát ngay.
#
# `-H 0.0.0.0`: nghe mọi giao diện mạng trong container, không thì cổng ánh xạ
# ra ngoài gọi vào không tới.
#
# Gọi Node ĐÍCH DANH, không qua `bun run dev`: bun run thay shebang node của
# bin `next` bằng chính bun, và ta quay lại đúng lỗi external ở trên.
CMD ["sh", "-c", "bun install --frozen-lockfile && exec node node_modules/next/dist/bin/next dev -H 0.0.0.0"]
