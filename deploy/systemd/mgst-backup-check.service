[Unit]
Description=Kiểm bản sao lưu MGST mới nhất có quá cũ không
After=docker.service
OnFailure=mgst-backup-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mgst-app
# Hai file, ĐÚNG THỨ TỰ này: .env.local mang khoá S3 của app, .env.backup mang
# bucket sao lưu và ghi đè khoá nếu ngày nào cấp khoá riêng.
EnvironmentFile=/opt/mgst-app/.env.local
EnvironmentFile=/opt/mgst-app/.env.backup
ExecStart=/root/.bun/bin/bun scripts/db-backup-check.ts
TimeoutStartSec=120
