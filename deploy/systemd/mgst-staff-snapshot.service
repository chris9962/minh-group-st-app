[Unit]
Description=Chụp nhân sự của tháng vừa kết thúc vào staff_months
After=docker.service
OnFailure=mgst-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mgst-app
# .env.local mang DATABASE_URL trỏ localhost:5433 — đúng khi chạy từ máy chủ,
# không phải từ trong container.
EnvironmentFile=/opt/mgst-app/.env.local
ExecStart=/root/.bun/bin/bun scripts/snapshot-staff-months.ts
TimeoutStartSec=300
