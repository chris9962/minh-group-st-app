node_modules
.next
.git
.gitignore

# Biến môi trường KHÔNG vào image. Máy chủ truyền lúc chạy bằng `--env-file`.
# Nướng secret vào layer thì ai kéo được image cũng đọc được khoá S3.
.env
.env.*

# Ảnh của bản tạm ghi đĩa — dữ liệu chạy, không phải mã nguồn.
.uploads

# ⚠️ Ảnh của bản CŨ, trước khi chuyển sang FPT Object Storage.
#
# Next phục vụ trọn `public/` ra web như file tĩnh, KHÔNG qua chốt kiểm phiên
# đăng nhập nào. Đóng thư mục này vào image là mở lại đúng lỗ vừa đi bịt: ai
# đoán đúng `/uploads/<key>` đều xem được ảnh chứng minh mà không cần đăng nhập.
# Đo được trên production 2026-08-21, đường cũ trả 200.
public/uploads

# Cấu hình Nginx và trang bảo trì — chạy trên máy chủ, ngoài container app.
deploy

# Không tham gia bản dựng máy chủ.
e2e
playwright.config.ts
playwright-report
test-results
docs
pvi-qlcd-playwright
scripts
drizzle

# Sinh ra bởi bản dựng native trên cùng máy. Nằm trong context thì `COPY . .` mất
# cache mỗi lần chạy `bun run build`, dù mã nguồn không đổi.
*.tsbuildinfo
.DS_Store
.claude

# Không tham gia bản dựng bên trong image.
Dockerfile
.dockerignore
docker-compose.yml
