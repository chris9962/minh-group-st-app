{
  "name": "mgst-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "docker compose up app-dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "bun --env-file=.env.local scripts/db-migrate.ts",
    "db:seed": "bun --env-file=.env.local scripts/db-seed.ts",
    "db:recount": "bun --env-file=.env.local scripts/db-recount.ts",
    "db:demo": "bun --env-file=.env.local scripts/db-demo.ts",
    "db:import-staff": "bun --env-file=.env.local scripts/db-import-staff.ts",
    "db:grant-missing": "bun --env-file=.env.local scripts/db-grant-missing-permissions.ts",
    "db:grant-department-read": "bun --env-file=.env.local scripts/db-grant-department-read.ts",
    "db:grant-adjust-kpi": "bun --env-file=.env.local scripts/db-grant-adjust-kpi.ts",
    "db:backup": "bun --env-file=.env.local --env-file=.env.backup scripts/db-backup.ts",
    "db:backup:check": "bun --env-file=.env.local --env-file=.env.backup scripts/db-backup-check.ts",
    "db:restore": "bun --env-file=.env.local --env-file=.env.backup scripts/db-restore.ts",
    "kpi:recompute": "bun --env-file=.env.local scripts/kpi-recompute.ts",
    "test:rules": "bun scripts/test-rules.ts",
    "e2e": "bun --env-file=.env.local scripts/e2e-clean.ts && bun --env-file=.env.local scripts/e2e-seed.ts && playwright test; bun --env-file=.env.local scripts/e2e-clean.ts",
    "e2e:ui": "bun --env-file=.env.local scripts/e2e-seed.ts && playwright test --ui",
    "pvi:login": "node pvi-qlcd-playwright/login.js",
    "pvi:ensure-login": "node pvi-qlcd-playwright/ensure-login.js",
    "pvi:check": "node pvi-qlcd-playwright/check-session.js",
    "pvi:order": "node pvi-qlcd-playwright/create-order.js",
    "pvi:chay": "node pvi-qlcd-playwright/chay-don.js",
    "pvi:duyet": "node pvi-qlcd-playwright/duyet-don.js",
    "pvi:chung-nhan": "bun --env-file=.env.local pvi-qlcd-playwright/worker.ts --chi-chung-nhan --mot-vong",
    "pvi:worker": "bun --env-file=.env.local pvi-qlcd-playwright/worker.ts",
    "pvi:order:dry": "node pvi-qlcd-playwright/create-order.js --dry-run",
    "webp:bench": "bun scripts/webp-bench.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jquery": "3",
    "sass": "^1.102.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
