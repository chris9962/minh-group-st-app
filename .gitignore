# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tài liệu làm việc của agent — chỉ giữ ở máy, không đưa lên repo
/docs

# script dựng bằng chứng khi review — chạy tay, chỉ đọc, không phải mã sản phẩm
/.probe

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Ảnh tải lên của bản lưu trữ tạm (chưa có S3) — dữ liệu chạy, không phải mã nguồn.
/.uploads

# Bot PVI. `storageState.json` là cookie đăng nhập thật, THAY CHO MẬT KHẨU —
# lên repo là ai đọc được repo cũng vào được hệ thống PVI của công ty.
# `anh/` và `captcha/` là ảnh chụp lúc chạy, script tự tạo lại.
/pvi-qlcd-playwright/storageState.json
/pvi-qlcd-playwright/anh/
/pvi-qlcd-playwright/captcha/
# Vết mạng ghi lúc chạy — chứa HTML trang thật, không phải mã nguồn.
/pvi-qlcd-playwright/vet/
__pycache__/

# Nhập nhân sự. `staff-import.json` là họ tên và số điện thoại của người thật,
# sinh lại được từ file HR gốc nên không có lý do nào để lên repo.
/scripts/data/staff-import.json
